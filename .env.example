# Public — safe to embed in the mobile app bundle
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# LocationIQ (locationiq.com dashboard). Restrict to the app's package name /
# bundle id in the LocationIQ dashboard rather than relying on secrecy.
LOCATIONIQ_PUBLIC_KEY=

# Server/tooling only — NEVER import these in app code (screens/lib used by the RN bundle)
SUPABASE_SECRET_KEY=
DATABASE_URL=
DIRECT_URL=
